{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug TunnyDashboard",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=${workspaceFolder}/egui-app/Cargo.toml",
                    "--bin=TunnyDashboard"
                ],
                "filter": {
                    "name": "TunnyDashboard",
                    "kind": "bin"
                }
            },
            "args": ["-i", "${workspaceFolder}/test.log"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            }
        }
    ]
}
